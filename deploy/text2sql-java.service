# Text-to-SQL Java 网关服务（W4 §5.6 原生部署形态）
# 放置位置（服务器）：/etc/systemd/system/text2sql-java.service
# 启用：systemctl daemon-reload && systemctl enable --now text2sql-java
# 与相册平台 spring_album-maker 的同构写法（用户熟悉的管理方式）
[Unit]
Description=Text-to-SQL Java Gateway (Spring Boot)
After=network.target mysqld.service

[Service]
Type=simple
WorkingDirectory=/opt/text2sql/current/backend
# 8080 被同机的相册平台占用 → 网关用 8081（nginx 反代 /api→8081）
ExecStart=/usr/bin/java -Xmx384m -Xms128m -XX:MaxMetaspaceSize=128m -jar /opt/text2sql/current/backend/text2sql-backend.jar --spring.profiles.active=prod --server.port=8081 --server.address=127.0.0.1
EnvironmentFile=/opt/text2sql/env.prod
# 内存预算（W4 设计 §5.2）：JVM 堆 384m + Metaspace 128m，容器内合计 ≤550MB
MemoryMax=550M
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
