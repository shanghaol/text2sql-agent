# ⚠️ 本文件是模板：真实 Key 只放 .env（已被 .gitignore 忽略），绝不写进本文件
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-flash

# ---- W2 MySQL（数据集建库/导入 + Agent 只读查询）----
# 只查询（Agent 用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=text2sql_ro
MYSQL_PASSWORD=change-me-read-only-password
MYSQL_DB=mart
# 建库/导入用（data/generate_dataset.py --init / --load 执行时需要）
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change-me-admin-password
# 只读账号 text2sql_ro 的密码（--init/--load 创建该账号时用到，必填无默认值）
MYSQL_RO_PASSWORD=change-me-read-only-password

# ---- W2 检索层（Chroma 索引 / Embedding / 检索注入条数）----
# Chroma 持久化目录（相对路径按仓库根拼接；默认 data/chroma_db）
CHROMA_PERSIST_DIR=data/chroma_db
# Embedding 模型（fastembed 本地 ONNX 加载）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 每轮注入 prompt 的检索条数上限（W6 消融调参入口）
RETRIEVER_TOP_N=8

# ---- W6 Rerank（评测侧用；详情见 deploy 文档）----
SILICONFLOW_API_KEY=sk-你的siliconflow-key
